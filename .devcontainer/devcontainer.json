{
	"name": "C# (.NET)",
	"image": "mcr.microsoft.com/devcontainers/dotnet:2-9.0",
	"runArgs": [ // docker run --network deo-network
		"--name",
		"deo-devcontainer",
		"--network",
		"deo-network"
	],
	"postCreateCommand": "dotnet restore --locked-mode && dotnet dev-certs https",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit",
				"SonarSource.sonarlint-vscode",
				"humao.rest-client",
				"ms-dotnettools.csharp"
			]
		}
	}
}